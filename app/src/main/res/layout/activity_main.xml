<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: initializing"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_overlay_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Grant Overlay Permission" />

        <Button
            android:id="@+id/btn_shizuku_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Request Shizuku &amp; Init Gamepad" />

        <Button
            android:id="@+id/btn_start_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Start Overlay" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_collapse_overlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Collapse Bubble" />

            <Button
                android:id="@+id/btn_toggle_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Edit Layout: OFF" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_toggle_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Settings: OFF" />

        <LinearLayout
            android:id="@+id/settings_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_sensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thumbstick Sensitivity: 1.00x" />

            <SeekBar
                android:id="@+id/seek_sensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="225"
                android:progress="75"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_deadzone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thumbstick Deadzone: 10%" />

            <SeekBar
                android:id="@+id/seek_deadzone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="45"
                android:progress="10"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hide Selected Controls:"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_show_all_controls"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Show All" />

                <Button
                    android:id="@+id/btn_hide_all_controls"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Hide All" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hide_controls_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_reset_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reset Default Positions" />

        <Button
            android:id="@+id/btn_stop_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Disengage / Stop Overlay" />
    </LinearLayout>
</ScrollView>
